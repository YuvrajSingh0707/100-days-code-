#include <stdio.h>

int main() {
    int num1, num2;
    
    // User se do numbers input lena
    scanf("%d %d", &num1, &num2);
    
    // Swapping bina third variable ke (Maths logic)
    num1 = num1 + num2;
    num2 = num1 - num2;
    num1 = num1 - num2;
    
    // Swapped output print karna exact test case format mein
    printf("After swap: %d %d\n", num1, num2);
    
    return 0;
}
