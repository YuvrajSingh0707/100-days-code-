#include <stdio.h>

int main() {
    int n;
    
    // Input an integer
    scanf("%d", &n);
    
    // Check positive, negative or zero using nested if-else
    if (n >= 0) {
        if (n == 0) {
            printf("Zero\n");
        } else {
            printf("Positive\n");
        }
    } else {
        printf("Negative\n");
    }
    
    return 0;
}
